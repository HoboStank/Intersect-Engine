  "AllowedHosts": "*",
  "Api": {
    "Enabled": true,
    "Cors": {},
    "AllowedNetworkTypes": 1,
    "AllowedNonHttpOnlyCookies": [
      "session-expires"
    ],
    "RequestLogLevel": 0,
    "TokenGenerationOptions": {
      "AccessTokenLifetime": 5,
      "Audience": "https://localhost/api",
      "Issuer": "https://localhost",
      "RefreshTokenLifetime": 10080,
      "Secret": "E13FC43889049345B61125E209A9FE24D43DB056C0C8669EEE4D34F9198CBA1DD8090E44073DC956037544106F8C5DF7A9EE0724408ABAC593BB3ABF53033927"
    },
    "KnownProxies": [],
